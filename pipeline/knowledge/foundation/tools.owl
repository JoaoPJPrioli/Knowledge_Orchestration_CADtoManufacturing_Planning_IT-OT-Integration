  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasGeometry">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Tool"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMaxDiameterMM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Tool"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMinDiameterMM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Tool"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMaxDepthMM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Tool"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasCostPerUnit">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Tool"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Tool">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#TurningInsertRough">
  <rdf:type rdf:resource="#Tool"/>
  <recommendedForOperation rdf:resource="http://onto.brep.org/manufacturing/machining-process#RoughTurningOp"/>
  <recommendedForOperation rdf:resource="http://onto.brep.org/manufacturing/machining-process#FacingOp"/>
  <hasToolLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rough Turning Insert</hasToolLabel>
  <hasToolType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Turning Insert</hasToolType>
  <hasToolMaterial rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Carbide</hasToolMaterial>
  <hasGeometry rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CNMG 120408</hasGeometry>
  <hasMaxDiameterMM rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.0</hasMaxDiameterMM>
  <hasMinDiameterMM rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.0</hasMinDiameterMM>
  <hasMaxDepthMM rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</hasMaxDepthMM>
  <hasCostPerUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12.5</hasCostPerUnit>
</owl:NamedIndividual>

