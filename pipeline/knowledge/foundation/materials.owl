<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://onto.brep.org/manufacturing/materials"
         xmlns="http://onto.brep.org/manufacturing/materials#">

<owl:Ontology rdf:about="http://onto.brep.org/manufacturing/materials"/>

<owl:DatatypeProperty rdf:about="#hasHardnessHRC">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Material"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasTensileStrengthMPa">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Material"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasYieldStrengthMPa">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Material"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasDensityGCM3">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Material"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMachinabilityRating">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Material"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasRecommendedCoolant">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Material"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasMaterialLabel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Material"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Material">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#AISI1045Steel">
  <rdf:type rdf:resource="#Material"/>
  <hasMaterialLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AISI 1045 Steel</hasMaterialLabel>
  <hasHardnessHRC rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">25.0</hasHardnessHRC>
  <hasTensileStrengthMPa rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">570.0</hasTensileStrengthMPa>
  <hasYieldStrengthMPa rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">440.0</hasYieldStrengthMPa>
  <hasDensityGCM3 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">7.85</hasDensityGCM3>
  <hasMachinabilityRating rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.6</hasMachinabilityRating>
  <hasRecommendedCoolant rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Soluble Oil</hasRecommendedCoolant>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Aluminum6061T6">
  <rdf:type rdf:resource="#Material"/>
  <hasMaterialLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aluminum 6061-T6</hasMaterialLabel>
  <hasHardnessHRC rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">60.0</hasHardnessHRC>
  <hasTensileStrengthMPa rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">310.0</hasTensileStrengthMPa>
  <hasYieldStrengthMPa rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">276.0</hasYieldStrengthMPa>
  <hasDensityGCM3 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.7</hasDensityGCM3>
  <hasMachinabilityRating rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</hasMachinabilityRating>
  <hasRecommendedCoolant rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Air or Mist</hasRecommendedCoolant>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#StainlessSteel304">
  <rdf:type rdf:resource="#Material"/>
  <hasMaterialLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stainless Steel 304</hasMaterialLabel>
  <hasHardnessHRC rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">70.0</hasHardnessHRC>
  <hasTensileStrengthMPa rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">515.0</hasTensileStrengthMPa>
  <hasYieldStrengthMPa rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">205.0</hasYieldStrengthMPa>
  <hasDensityGCM3 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.0</hasDensityGCM3>
  <hasMachinabilityRating rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</hasMachinabilityRating>
  <hasRecommendedCoolant rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Soluble Oil</hasRecommendedCoolant>
</owl:NamedIndividual>


</rdf:RDF>
