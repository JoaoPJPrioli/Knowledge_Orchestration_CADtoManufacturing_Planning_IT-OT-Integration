  <hasFeedRateUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mm/rev</hasFeedRateUnit>
  <hasSpindleSpeedValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">480.0</hasSpindleSpeedValue>
  <hasSpindleSpeedUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RPM</hasSpindleSpeedUnit>
  <hasDepthOfCutValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</hasDepthOfCutValue>
