         xml:base="http://onto.brep.org/manufacturing/cutting-parameters"
         xmlns="http://onto.brep.org/manufacturing/cutting-parameters#">

<owl:Ontology rdf:about="http://onto.brep.org/manufacturing/cutting-parameters">
  <owl:imports rdf:resource="http://onto.brep.org/manufacturing/materials"/>
  <owl:imports rdf:resource="http://onto.brep.org/manufacturing/machining-process"/>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#forMaterial">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#CuttingParameterSet"/>
