</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#forOperation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#CuttingParameterSet"/>
  <rdfs:range rdf:resource="http://onto.brep.org/manufacturing/machining-process#Operation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCuttingParameterSet">
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="#CuttingParameterSet"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasFeedRateValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#CuttingParameterSet"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasFeedRateUnit">
