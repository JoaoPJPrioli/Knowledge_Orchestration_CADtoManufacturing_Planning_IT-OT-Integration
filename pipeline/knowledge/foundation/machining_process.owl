  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#Counterbore">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#Boss">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#ThroughHole">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#Slot">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#Groove">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#KeyFeature">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#Operation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#RoughTurning">
  <rdfs:subClassOf rdf:resource="#Operation"/>
</owl:Class>

<owl:Class rdf:about="#FinishTurning">
  <rdfs:subClassOf rdf:resource="#Operation"/>
</owl:Class>

<owl:Class rdf:about="#Drilling">
  <rdfs:subClassOf rdf:resource="#Operation"/>
</owl:Class>

<owl:Class rdf:about="#Counterboring">
  <rdfs:subClassOf rdf:resource="#Operation"/>
</owl:Class>

<owl:Class rdf:about="#Chamfering">
  <rdfs:subClassOf rdf:resource="#Operation"/>
</owl:Class>

<owl:Class rdf:about="#Boring">
  <rdfs:subClassOf rdf:resource="#Operation"/>
</owl:Class>

<owl:Class rdf:about="#Facing">
  <rdfs:subClassOf rdf:resource="#Operation"/>
</owl:Class>

<owl:Class rdf:about="#Milling">
  <rdfs:subClassOf rdf:resource="#Operation"/>
</owl:Class>

<owl:Class rdf:about="#Grooving">
  <rdfs:subClassOf rdf:resource="#Operation"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#RoughTurningOp">
  <rdf:type rdf:resource="#RoughTurning"/>
  <requiresToolAlongFeatureAxis rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</requiresToolAlongFeatureAxis>
  <hasPrecedenceOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasPrecedenceOrder>
  <hasOperationLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rough Turning</hasOperationLabel>
  <hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove bulk material to near-final dimensions</hasDescription>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G00</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G01</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G02</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G03</hasGCode>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#FinishTurningOp">
  <rdf:type rdf:resource="#FinishTurning"/>
  <requiresToolAlongFeatureAxis rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</requiresToolAlongFeatureAxis>
  <hasPrecedenceOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasPrecedenceOrder>
  <hasOperationLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Finish Turning</hasOperationLabel>
  <hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Final pass to achieve surface finish and tolerance</hasDescription>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G00</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G01</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G02</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G03</hasGCode>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#DrillingOp">
  <rdf:type rdf:resource="#Drilling"/>
  <requiresToolAlongFeatureAxis rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</requiresToolAlongFeatureAxis>
  <hasPrecedenceOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasPrecedenceOrder>
  <hasOperationLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Drilling</hasOperationLabel>
  <hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Create hole using drill bit</hasDescription>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G00</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G01</hasGCode>
  <hasCycleCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G83</hasCycleCode>
  <hasCycleCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G81</hasCycleCode>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CounterboringOp">
  <rdf:type rdf:resource="#Counterboring"/>
  <requiresToolAlongFeatureAxis rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</requiresToolAlongFeatureAxis>
  <hasPrecedenceOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</hasPrecedenceOrder>
  <hasOperationLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Counterboring</hasOperationLabel>
  <hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enlarge entrance of hole for head clearance</hasDescription>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G00</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G01</hasGCode>
  <hasCycleCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G82</hasCycleCode>
  <hasCycleCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G81</hasCycleCode>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ChamferingOp">
  <rdf:type rdf:resource="#Chamfering"/>
  <requiresToolAlongFeatureAxis rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</requiresToolAlongFeatureAxis>
  <hasPrecedenceOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</hasPrecedenceOrder>
  <hasOperationLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chamfering</hasOperationLabel>
  <hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Create angled edge transition</hasDescription>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G00</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G01</hasGCode>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#BoringOp">
  <rdf:type rdf:resource="#Boring"/>
  <requiresToolAlongFeatureAxis rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</requiresToolAlongFeatureAxis>
  <hasPrecedenceOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</hasPrecedenceOrder>
  <hasOperationLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Boring</hasOperationLabel>
  <hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enlarge or finish existing hole to precise diameter</hasDescription>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G00</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G01</hasGCode>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#FacingOp">
  <rdf:type rdf:resource="#Facing"/>
  <requiresToolAlongFeatureAxis rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</requiresToolAlongFeatureAxis>
  <hasPrecedenceOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</hasPrecedenceOrder>
  <hasOperationLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Facing</hasOperationLabel>
  <hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Machine flat surface perpendicular to axis of rotation</hasDescription>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G00</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G01</hasGCode>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#MillingOp">
  <rdf:type rdf:resource="#Milling"/>
  <requiresToolAlongFeatureAxis rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</requiresToolAlongFeatureAxis>
  <hasPrecedenceOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9</hasPrecedenceOrder>
  <hasOperationLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Milling</hasOperationLabel>
  <hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Remove material using rotating multi-point cutter</hasDescription>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G00</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G01</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G02</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G03</hasGCode>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#GroovingOp">
  <rdf:type rdf:resource="#Grooving"/>
  <requiresToolAlongFeatureAxis rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</requiresToolAlongFeatureAxis>
  <hasPrecedenceOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</hasPrecedenceOrder>
  <hasOperationLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grooving</hasOperationLabel>
  <hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cut narrow groove into workpiece</hasDescription>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G00</hasGCode>
  <hasGCode rdf:datatype="http://www.w3.org/2001/XMLSchema#string">G01</hasGCode>
</owl:NamedIndividual>


</rdf:RDF>
