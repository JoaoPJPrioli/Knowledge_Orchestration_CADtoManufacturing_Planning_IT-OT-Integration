<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://onto.brep.org/manufacturing/machining-process"
         xmlns="http://onto.brep.org/manufacturing/machining-process#">

<owl:Ontology rdf:about="http://onto.brep.org/manufacturing/machining-process"/>

<owl:ObjectProperty rdf:about="#requiresOperation">
  <rdfs:domain rdf:resource="#Feature"/>
  <rdfs:range rdf:resource="#Operation"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#requiresToolAlongFeatureAxis">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Operation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasPrecedenceOrder">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Operation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasOperationLabel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Operation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasDescription">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Operation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasGCode">
  <rdfs:domain rdf:resource="#Operation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasCycleCode">
  <rdfs:domain rdf:resource="#Operation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Feature">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Step">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#Cylinder">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

<owl:Class rdf:about="#ChamferFeature">
  <rdfs:subClassOf rdf:resource="#Feature"/>
</owl:Class>

