<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://onto.brep.org/manufacturing/motor-shaft-case"
         xmlns="http://onto.brep.org/manufacturing/motor-shaft-case#">

<owl:Ontology rdf:about="http://onto.brep.org/manufacturing/motor-shaft-case">
  <owl:imports rdf:resource="http://onto.brep.org/manufacturing/machining-process"/>
  <owl:imports rdf:resource="http://onto.brep.org/manufacturing/materials"/>
  <owl:imports rdf:resource="http://onto.brep.org/manufacturing/tools"/>
  <owl:imports rdf:resource="http://onto.brep.org/manufacturing/machines"/>
  <owl:imports rdf:resource="http://onto.brep.org/manufacturing/cutting-parameters"/>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#madeOfMaterial">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://onto.brep.org/manufacturing/machining-process#Feature"/>
  <rdfs:range rdf:resource="http://onto.brep.org/manufacturing/materials#Material"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#machinedOn">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://onto.brep.org/manufacturing/machining-process#Feature"/>
  <rdfs:range rdf:resource="http://onto.brep.org/manufacturing/machines#Machine"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requiresTool">
  <rdfs:domain rdf:resource="http://onto.brep.org/manufacturing/machining-process#Feature"/>
  <rdfs:range rdf:resource="http://onto.brep.org/manufacturing/tools#Tool"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasCase">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:NamedIndividual rdf:about="#MotorShaftCaseMarker">
  <rdf:type rdf:resource="http://onto.brep.org/manufacturing/machining-process#Feature"/>
  <hasCase rdf:datatype="http://www.w3.org/2001/XMLSchema#string">motor_shaft_eixo</hasCase>
</owl:NamedIndividual>


</rdf:RDF>
