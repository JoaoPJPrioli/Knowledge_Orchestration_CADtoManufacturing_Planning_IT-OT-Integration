mfg:op_counterboring a mfg:Operation ;
    mfg:description "Enlarge entrance of hole for head clearance" ;
    mfg:hasGCodes mfg:params_counterboring ;
    mfg:id "counterboring" ;
    mfg:name "Counterboring" ;
    mfg:nodeType "operation" .

mfg:op_grooving a mfg:Operation ;
    mfg:description "Cut narrow groove into workpiece" ;
    mfg:hasGCodes mfg:params_grooving ;
    mfg:id "grooving" ;
    mfg:name "Grooving" ;
    mfg:nodeType "operation" .

mfg:param_10_coolant a mfg:ParameterRecord ;
    mfg:inputFeatureId "1" ;
    mfg:inputFeatureType "Step" ;
    mfg:inputMappingConfidence 6.206136e-01 ;
    mfg:inputMaterial "AISI1045Steel" ;
    mfg:ontologySource <http://onto.brep.org/manufacturing/cutting-parameters#> ;
    mfg:parameterName "coolant" ;
    mfg:ruleId "aisi1045_finishturning_params" ;
    mfg:source "swrl_rule" ;
    mfg:stepNumber 10 ;
    mfg:unit "bool" ;
    mfg:value true .

mfg:param_10_depth_of_cut a mfg:ParameterRecord ;
    mfg:inputFeatureId "1" ;
    mfg:inputFeatureType "Step" ;
    mfg:inputMappingConfidence 6.206136e-01 ;
    mfg:inputMaterial "AISI1045Steel" ;
    mfg:ontologySource <http://onto.brep.org/manufacturing/cutting-parameters#> ;
    mfg:parameterName "depth_of_cut" ;
    mfg:ruleId "aisi1045_finishturning_params" ;
    mfg:source "swrl_rule" ;
    mfg:stepNumber 10 ;
    mfg:unit "mm" ;
    mfg:value 2e-01 .

mfg:param_10_feed_rate a mfg:ParameterRecord ;
    mfg:inputFeatureId "1" ;
    mfg:inputFeatureType "Step" ;
    mfg:inputMappingConfidence 6.206136e-01 ;
    mfg:inputMaterial "AISI1045Steel" ;
    mfg:ontologySource <http://onto.brep.org/manufacturing/cutting-parameters#> ;
    mfg:parameterName "feed_rate" ;
    mfg:ruleId "aisi1045_finishturning_params" ;
    mfg:source "swrl_rule" ;
    mfg:stepNumber 10 ;
    mfg:unit "mm/rev" ;
    mfg:value 6e-02 .

mfg:param_10_spindle_speed a mfg:ParameterRecord ;
    mfg:inputFeatureId "1" ;
    mfg:inputFeatureType "Step" ;
    mfg:inputMappingConfidence 6.206136e-01 ;
    mfg:inputMaterial "AISI1045Steel" ;
    mfg:ontologySource <http://onto.brep.org/manufacturing/cutting-parameters#> ;
